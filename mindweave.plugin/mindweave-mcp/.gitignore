# 用户数据（绝不入库）
data/notes/*.json
data/reviews/*.json
data/images/*
data/exports/*
data/quizzes/*.json
# 保留目录结构
!data/notes/.gitkeep
!data/reviews/.gitkeep
!data/images/.gitkeep
!data/exports/.gitkeep
!data/quizzes/.gitkeep

# uv / python
.venv/
.uv-cache/            # 沙箱环境规避 D:\yecll\uv-cache 写入限制的临时缓存
__pycache__/
*.pyc
.mypy_cache/
.pytest_cache/
.ruff_cache/
# pytest-cov 覆盖率产物
.coverage
